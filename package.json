{
  "name": "stickyinc",
  "version": "0.5.2",
  "description": "A reification layer between LLM conversations and your commitments. MCP server + floating pane.",
  "type": "module",
  "bin": {
    "stickyinc-mcp": "./dist/index.js",
    "stickyinc-watch": "./dist/watch-cli.js"
  },
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js dist/watch-cli.js",
    "bundle": "esbuild src/index.ts --bundle --platform=node --format=esm --target=node22 --outfile=dist/bundle/stickyinc-mcp.mjs",
    "start": "node dist/index.js",
    "watch": "tsx src/watch-cli.ts",
    "typecheck": "tsc --noEmit"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^25.6.0",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
