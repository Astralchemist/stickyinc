{
  "name": "stickyinc",
  "version": "0.5.2",
  "description": "A reification layer between LLM conversations and your commitments. MCP server + floating pane.",
  "type": "module",
  "bin": {
    "stickyinc": "dist/bundle/stickyinc-mcp.mjs",
    "stickyinc-watch": "dist/bundle/stickyinc-watch.mjs"
  },
  "files": [
    "dist/bundle/"
  ],
  "scripts": {
    "dev": "tsx src/index.ts",
    "build": "tsc && chmod +x dist/index.js dist/watch-cli.js",
    "bundle": "node scripts/bundle.mjs",
    "start": "node dist/index.js",
    "watch": "tsx src/watch-cli.ts",
    "typecheck": "tsc --noEmit",
    "test": "tsx --test src/*.test.ts pane/src/*.test.ts",
    "prepublishOnly": "tsc --noEmit && tsx --test src/*.test.ts pane/src/*.test.ts && node scripts/bundle.mjs && node smoke.mjs dist/bundle/stickyinc-mcp.mjs"
  },
  "keywords": [
    "mcp",
    "mcp-server",
    "model-context-protocol",
    "claude",
    "todo",
    "tasks"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Astralchemist/stickyinc.git"
  },
  "homepage": "https://github.com/Astralchemist/stickyinc#readme",
  "bugs": "https://github.com/Astralchemist/stickyinc/issues",
  "license": "MIT",
  "engines": {
    "node": ">=22.13"
  },
  "devDependencies": {
    "@modelcontextprotocol/sdk": "^1.0.0",
    "@types/node": "^25.6.0",
    "chrono-node": "^2.10.1",
    "esbuild": "^0.27.7",
    "tsx": "^4.19.1",
    "typescript": "^6.0.3",
    "zod": "^3.23.8"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
